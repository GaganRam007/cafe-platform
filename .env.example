# ==============================================================================
# Aura Cafe Management & POS Operating System - Environment Configuration
# ==============================================================================

# Application & Environment
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://cafe_admin:cafe_secure_pass@localhost:5432/cafe_db?schema=public"

# Redis Pub/Sub & Caching (Redis 7+ / Upstash)
REDIS_URL="redis://localhost:6379"

# Security & Cryptography
# Generate a strong 64-character secret using: openssl rand -hex 32
JWT_SECRET="aura_cafe_jwt_production_secret_key_2026_super_secure_change_me"
QR_SIGNING_SECRET="aura_qr_super_secure_secret_2026_hmac_sha256_change_me"

# Cafe Business & Tax Identifiers
CAFE_ID="cafe-aura-01"
CAFE_NAME="Aura Artisan Coffee & Bistro"
CAFE_ADDRESS="742 Evergreen Terrace, Downtown Arts District, Bengaluru"
CAFE_PHONE="+91 80 4123 4567"
GSTIN="29AABCU9603R1ZM"
FSSAI_NUMBER="11223344556677"
SAC_CODE="996331"

# Tax & Service Charges (Defaults)
CGST_RATE="0.025"        # 2.5% Central GST
SGST_RATE="0.025"        # 2.5% State GST
SERVICE_FEE_RATE="0.05"  # 5% Optional Service Charge
DEFAULT_CURRENCY="INR"
DEFAULT_CURRENCY_SYMBOL="₹"

# Meta WhatsApp Cloud API (Automated Tax Invoicing)
# Obtain from Meta Developers Portal (WhatsApp Cloud API App)
WHATSAPP_API_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="109876543210123"
WHATSAPP_BUSINESS_ACCOUNT_ID="109876543210456"
WHATSAPP_TEMPLATE_NAME="cafe_gst_invoice"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="aura_whatsapp_webhook_token_2026"

# SMS Gateway (Fast2SMS / Twilio / MSG91 for Customer Diner OTP Login)
SMS_GATEWAY_API_KEY=""
SMS_SENDER_ID=""
